# Copy this file to .env and fill in real values. Never commit .env.

# --- Django core ---
DJANGO_SETTINGS_MODULE=examination_management_system.settings.dev
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=True
DJANGO_LEVEL_LOG=INFO

# --- Database (dev settings: postgresql, discrete fields) ---
DB_NAME=result_system
DB_HOST=localhost
DB_USER=result_system
DB_PASSWORD=change-me

# --- Database (prod settings: single DSN via dj-database-url instead of DB_* above) ---
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Prod-only ---
# ALLOWED_HOSTS=yourdomain.com
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_HOST_USER=user@example.com
# EMAIL_PORT=587
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=True
